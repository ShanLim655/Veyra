# Database dialect. MariaDB is the default; set USE_MARIADB=false to run the
# API on PostgreSQL instead (see docs/postgres.md). Any other value keeps
# MariaDB. When false, the MARIADB_* settings below are ignored.
USE_MARIADB=true

# For Vercel, use the pooled MariaDB connection details from Layerbase.
# Keep this app on the pooled endpoint so function instances reuse a small
# number of database connections. 127.0.0.1 is only for local MariaDB.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=veyra
MARIADB_USER=veyra_app
MARIADB_PASSWORD=replace-with-a-strong-database-password
MARIADB_POOL_SIZE=1
# Keep false for local MariaDB. Set true for the TLS-protected Layerbase endpoint.
MARIADB_SSL=false

# PostgreSQL settings — only used when USE_MARIADB=false. Plain TCP only;
# TLS/SSL is intentionally not used for PostgreSQL. POSTGRES_POOL_SIZE
# overrides MARIADB_POOL_SIZE for the pg pool.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=veyra
POSTGRES_USER=veyra_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# POSTGRES_POOL_SIZE=1

# Optional shared Redis for short-lived read caching, request coalescing, and
# retryable Realtime event delivery. Use redis:// for a Redis endpoint without TLS.
# Format: redis://[:password@]host:port[/database]
REDIS_URL=

# Local/self-hosted Node API settings. Vercel sets NODE_ENV automatically.
PORT=3001
APP_URL=https://your-veyra-domain.example

# Google OAuth Web application credentials. These are server-only; never use VITE_.
# Add APP_URL/api/auth/google/callback as an authorized redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Storage uploads and Realtime broadcasts run through the Veyra API.
# This service key also powers optional attachment cleanup. Keep both server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only key for signed avatar/banner uploads, MariaDB change broadcasts,
# and expired-object cleanup. Never add a VITE_ prefix to this key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# API key for direct Sequenzy transactional email sends (verification/reset).
# Store this only on the Node API server. Create a key with transactional:send.
SEQUENZY_API_KEY=replace-with-sequenzy-company-api-key

# Optional, one-time source connection for importing old Supabase Postgres
# application tables into MariaDB. Remove it after the import.
# This is a database password-bearing secret; never use a VITE_ prefix.
LEGACY_POSTGRES_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Vite embeds VITE_* variables into the frontend build. MariaDB credentials
# and server secrets must never use the VITE_ prefix.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
# Optional GIPHY API key for the chat GIF picker. When unset, the public
# GIPHY beta key is used (rate-limited). Create a free key at developers.giphy.com.
VITE_GIPHY_API_KEY=
# Server-side hCaptcha secret. Set the matching secret if you enable the site key.
HCAPTCHA_SECRET=your-hcaptcha-secret

# Optional shared secret for scheduled attachment cleanup. Generate your own
# random value, set it in the API runtime environment, and send it in x-cron-secret when calling
# POST /api/maintenance/purge-expired-attachments.
PURGE_CRON_SECRET=replace-with-a-long-random-secret

# Optional public ntfy server base URL used by push notifications.
NTFY_SERVER_URL=https://ntfy.chat-amani.xyz

# Server-side encryption for message content stored in MariaDB (NOT end-to-end
# encryption; the API still decrypts for authorized reads and moderation).
# Generate a 32-byte key, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# When unset, message content is stored without encryption. See docs/message-encryption.md.
MESSAGE_ENCRYPTION_KEY=
# Optional comma-separated previous keys (base64, 32 bytes each) tried only
# during decryption, used for zero-downtime key rotation.
MESSAGE_ENCRYPTION_KEY_PREVIOUS=

# Optional Altare Queues integration for background jobs. Disabled by default:
# when ALTARE_QUEUE_URL is empty the API never connects to a queue and runs
# supported work inline. See docs/queues.md.
# Queue endpoint, e.g. https://kv-us.altare.global/v1/queues/q_xxx
ALTARE_QUEUE_URL=
# Bearer token for the queue (sent as Authorization: Bearer <token>).
ALTARE_QUEUE_TOKEN=
# Optional publish timeout in milliseconds (default 5000, clamped 500-30000).
ALTARE_QUEUE_TIMEOUT_MS=5000
# Shared secret a queue worker must send as x-queue-worker-secret to
# POST /api/queues/deliver. Required only if you run a worker for queued
# notification jobs. Generate your own random value.
QUEUES_WORKER_SECRET=
# Worker-side settings for scripts/altare-queue-worker.mjs (not needed by the API):
# APP_URL=http://localhost:3001
# ALTARE_QUEUE_MAX_MESSAGES=10
# ALTARE_QUEUE_WAIT_SECONDS=20
# ALTARE_QUEUE_RETRY_SECONDS=30
