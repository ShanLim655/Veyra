# For Vercel, MariaDB must be reachable from Vercel Functions.
# 127.0.0.1 only works when the API runs on the database machine.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=veyra
MARIADB_USER=veyra_app
MARIADB_PASSWORD=replace-with-a-strong-database-password
MARIADB_POOL_SIZE=10

# Local/self-hosted Node API settings. Vercel sets NODE_ENV automatically.
PORT=3001
NODE_ENV=production
APP_URL=https://your-veyra-domain.example

# Google OAuth Web application credentials. These are server-only; never use VITE_.
# Add APP_URL/api/auth/google/callback as an authorized redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Storage cleanup is server-side; keep this URL and service key private.
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only key used by the scheduled attachment cleanup endpoint to delete
# expired objects from Supabase Storage. Never add a VITE_ prefix to this key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# API key for direct Sequenzy transactional email sends (verification/reset).
# Store this only on the Node API server. Create a key with transactional:send.
SEQUENZY_API_KEY=replace-with-sequenzy-company-api-key

# Optional, one-time source connection for importing old Supabase Postgres
# application tables into MariaDB. Remove it after the import.
# This is a database password-bearing secret; never use a VITE_ prefix.
LEGACY_POSTGRES_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Vite embeds VITE_* variables into the frontend build. MariaDB credentials
# and server secrets must never use the VITE_ prefix.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
# Server-side hCaptcha secret. Set the matching secret if you enable the site key.
HCAPTCHA_SECRET=your-hcaptcha-secret

# Optional shared secret for scheduled attachment cleanup. Generate your own
# random value, set it on the VPS, and send it in x-cron-secret when calling
# POST /api/maintenance/purge-expired-attachments.
PURGE_CRON_SECRET=replace-with-a-long-random-secret

# Optional public ntfy server base URL used by push notifications.
NTFY_SERVER_URL=https://ntfy.chat-amani.xyz
